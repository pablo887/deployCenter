# Entorno de un cliente — vive SIEMPRE en el servidor del cliente.
#
# Este archivo es un ejemplo con valores inventados, para poder correr el
# toolchain de punta a punta. Un .env real nunca se versiona en este repo: el hub
# conoce los NOMBRES de las variables, jamás los valores.
#
# En el servidor del cliente se llama .env y vive junto al docker-compose.yml
# generado, en el directorio del stack de ese producto.

# --- topología -------------------------------------------------------------
MEP_PUERTO_WEB=8443
# 127.0.0.1 publica el front solo en loopback, para poner el reverse proxy del
# cliente adelante. 0.0.0.0 lo expone en la red.
MEP_EXPONER_EN=127.0.0.1

# --- base de datos ---------------------------------------------------------
MEP_DB_NOMBRE=mep
MEP_DB_USUARIO=mep
MEP_DB_CLAVE=reemplazar-en-el-servidor-del-cliente

# --- aplicación ------------------------------------------------------------
MEP_LOG_NIVEL=info
