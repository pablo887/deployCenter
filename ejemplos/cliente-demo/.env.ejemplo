# Entorno de un cliente de MEP (núcleo) — vive SIEMPRE en el servidor del cliente.
#
# Valores inventados, para correr el toolchain de punta a punta. Un .env real
# nunca se versiona en este repo: el hub conoce los NOMBRES de las variables,
# jamás los valores.
#
# En el servidor del cliente se llama .env y vive junto al docker-compose.yml
# generado, en el directorio del stack (por ejemplo /opt/accusys/mep).

# --- BCRA -----------------------------------------------------------------
BCRA_USER=usuario-demo
BCRA_PASS=reemplazar-en-el-servidor-del-cliente
BCRA_ENDPOINT=https://serviciosmep.homologacion.bcra.sfa/api
# solo si la red del banco no resuelve esos nombres
BCRA_IP_HOMOLOGACION=192.0.2.59

# --- base de MEP (SQL Server, externa) --------------------------------------
CS_SERVER=sql.demo.invalid
CS_PORT=1433
CS_DATABASE=MEP
CS_USER=mep
CS_PASS=reemplazar-en-el-servidor-del-cliente

CS_LOG_SERVER=sql.demo.invalid
CS_LOG_PORT=1433
CS_LOG_DATABASE=MEP_LOG
CS_LOG_USER=mep
CS_LOG_PASS=reemplazar-en-el-servidor-del-cliente

# --- API ------------------------------------------------------------------
API_CLIENTES=http://mep-connector

# --- IdP y front ------------------------------------------------------------
ENTIDAD=99999
IDP_CLIENT_ID=mep-demo
IDP_SERVER_URL=http://idp.demo.invalid:8090
# la informa el stack del banco; el front la muestra
MEP_CONNECTOR_VERSION=1.0.31
