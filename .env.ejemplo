# Configuración del hub para docker-compose.yml. Copialo a .env (que no se
# versiona) y completalo:   cp .env.ejemplo .env

# --- base de datos -------------------------------------------------------------
# Postgres local, en un volumen de Docker.
COMPOSE_PROFILES=db-local
DB_PASSWORD=cambiame-por-una-clave-larga

# Para usar la base del proyecto de Supabase en vez de la local: borrá
# COMPOSE_PROFILES y descomentá esto, con la cadena del pooler de sesión
# (Project Settings → Database → Connection string → Session pooler):
# DC_HUB_DB=postgresql+psycopg://postgres.<ref>:<clave>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# --- identidad (Supabase Auth) ---------------------------------------------------
# De acá salen el login, el segundo factor y las claves con que el hub valida
# cada token (JWKS). Project Settings → API Keys.
SUPABASE_URL=https://<ref>.supabase.co
# Pública por diseño: viaja al navegador para el login.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Invitaciones (opcional): con la secret key, Aprobador y Comercial invitan por
# email desde la web y el hub devuelve el link para elegir contraseña. Sin ella,
# las altas son por id. Es de administración: vive solo en el hub, nunca llega
# al navegador. Project Settings → API Keys → Secret keys.
# SUPABASE_SECRET_KEY=sb_secret_...
# Adónde vuelve la persona después de abrir el link. Tiene que estar en
# Authentication → URL Configuration → Redirect URLs del proyecto.
# DC_HUB_URL_PUBLICA=http://localhost:8000

# --- red -------------------------------------------------------------------------
# Puerto del host donde queda la web y la API.
DC_PUERTO=8000

# --- demo del agente (perfil agente-demo) -------------------------------------------
# Suma el producto demo (nginx) al catálogo y levanta un agente en esta máquina.
# Pasos en ejemplos/demo-agente/README.md.
# COMPOSE_PROFILES=db-local,agente-demo
# DC_HUB_CATALOGO_EXTRA=/app/ejemplos/demo-agente/catalogo
# El código sale de: docker compose exec hub dc-hub codigo <cliente> --host demo-01
# DC_AGENTE_CODIGO=DC-XXXX-XXXX

# --- desarrollo sin Supabase ---------------------------------------------------------
# Con un secreto compartido el hub acepta tokens de `dc-hub token-dev` y la web
# pide pegar uno en lugar del login. Nunca en un ambiente real.
# DC_JWT_SECRET=un-secreto-de-al-menos-32-caracteres
